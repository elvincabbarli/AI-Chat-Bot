{
  "permissions": {
    "allow": [
      "Bash(npm build)",
      "Bash(npm test)",
      "Bash(npm type-check)",
      "Bash(git status)",
      "Bash(git diff *)"
    ],
    "ask": [
        "Bash(git push *)"
    ],
    "deny": [
        "Read(.env)",
        "Read(.env.*)",
        "Edit(.env)",
        "Edit(.env.*)"
    ]
  }
}